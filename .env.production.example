APP_ENV=production

DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bookstore_production
DB_USER=postgres
DB_PASS=replace_with_real_db_password

JWT_SECRET=replace_with_long_random_secret
JWT_TTL_SECONDS=604800
JWT_REFRESH_TTL_SECONDS=2592000
ADMIN_REGISTER_SECRET=replace_with_admin_bootstrap_secret
FRONTEND_ORIGIN=https://your-frontend-domain.com

RESET_TOKEN_EXPIRY_MINUTES=15

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_real_email
MAIL_PASSWORD=replace_with_real_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=replace_with_real_email
MAIL_FROM_NAME=Bookly
